#!/bin/sh
#
# PX4 FMUv4 specific board extras init
#------------------------------------------------------------------------------

# Run FrSky Telemetry on Pixracer on the FrSky port if not enabled already
# if param compare TEL_FRSKY_CONFIG 0
# then
# 	frsky_telemetry start -d /dev/ttyS6 -t 15
# fi

# dhcpd_start wlan0
# ifdown wlan0
# ifconfig
airspeed_selector stop
fw_pos_control stop
land_detector stop
rc_update stop
fw_autotune_attitude_control stop
mag_bias_estimator stop

ifup wlan1
wapi psk wlan1 12345678 3
wapi essid wlan1 MY_PX6 1
ifconfig wlan1 10.0.0.2 netmask 255.255.255.0

mavlink start -u 14556 -p -r 100000 -n wlan1 -x
# esp_inv_ctrl
#mavlink start -d /dev/ttyACM0 -b 2000000 -m onboard
