#!/bin/sh
#
# PX4 FMUv4 specific board sensors init
#------------------------------------------------------------------------------


if ! icm42688p -s -R 2 start
then
	if ! icm42605 -s -R 2 start
	then
		if ! icm20602 -s -R 2 start
		then
			if ! icm42670p -s -R 2 start
			then
			        echo "No IMU detected"
			fi
		fi
	fi
fi

if param compare -s SYS_HAS_MAG 1
then
	ist8310 start -I -a 12
fi

if param compare -s SYS_HAS_BARO 1
then
	spl06 -I -a 119 start
fi

if param compare -s ADC_ADS1115_EN 1
then
	ads1115 start -X
else
	board_adc start
fi

ip5109 start -X

#flow3953 start -d /dev/ttyS2

vl53l0x start -X
